<script>
window.addEventListener("load", function () {
  var details = document.querySelectorAll("details");
  var questions = [];

  for (var i = 0; i < details.length; i++) {
    var det = details.item(i);
    var sum = det.querySelector("summary");
    if (!sum || sum.textContent.indexOf("Показать ответ") === -1) continue;

    var ul = det.previousElementSibling;
    if (!ul || ul.tagName !== "UL") continue;

    var p = ul.previousElementSibling;
    if (!p || p.tagName !== "P") continue;

    var lis = ul.querySelectorAll("li");
    if (lis.length < 2) continue;

    var clone = det.cloneNode(true);
    var cSum = clone.querySelector("summary");
    if (cSum) cSum.remove();

    var expHtml = clone.innerHTML.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>").trim();
    var plain = clone.textContent.replace(/[\*\s]+/g, " ").trim();
    var firstChar = plain.charAt(0).toUpperCase();
    var map = { "А": "A", "Б": "B", "В": "C", "Г": "D" };
    var correct = map.hasOwnProperty(firstChar) ? map[firstChar] : firstChar;

    var opts = [];
    for (var j = 0; j < lis.length; j++) {
      var li = lis.item(j);
      var ch = li.textContent.trim().charAt(0).toUpperCase();
      ch = map.hasOwnProperty(ch) ? map[ch] : ch;
      var txt = li.innerHTML.trim().replace(/^[A-DА-Г][\)\.\:]\s*/i, "");
      opts.push({ letter: ch, html: txt });
    }

    questions.push({
      qHtml: p.innerHTML,
      options: opts,
      correct: correct,
      expHtml: expHtml,
      pNode: p,
      ulNode: ul,
      detNode: det
    });
  }

  if (questions.length === 0) return;

  // 1. Hide the fallback instruction paragraph if present
  var allParagraphs = document.querySelectorAll("p");
  for (var pIdx = 0; pIdx < allParagraphs.length; pIdx++) {
    var pEl = allParagraphs.item(pIdx);
    if (pEl.textContent.indexOf("Выбери вариант, а затем открой") !== -1) {
      pEl.remove();
      break;
    }
  }

  var total = questions.length;
  var cur = 0;
  var score = 0;
  var winnings = "$0";
  var busted = false;
  var key = "quiz_best_" + window.location.pathname;

  var logos = [
    "/img/user/who0.webp", "/img/user/who1.webp", "/img/user/who2.webp",
    "/img/user/who3.webp", "/img/user/who4.webp", "/img/user/who5.webp",
    "/img/user/who6.webp", "/img/user/who7.webp", "/img/user/who8.webp",
    "/img/user/who9.webp", "/img/who0.webp", "/img/who1.webp",
    "/img/who2.webp", "/img/who3.webp", "/img/who4.webp",
    "/img/who5.webp", "/img/who6.webp", "/img/who7.webp",
    "/img/who8.webp", "/img/who9.webp"
  ];

  var prizeList = [
    "$100", "$200", "$300", "$500", "$1,000",
    "$2,000", "$4,000", "$8,000", "$16,000", "$32,000",
    "$64,000", "$125,000", "$250,000", "$500,000", "$750,000", "$1 Million"
  ];

  function getMoney(idx) {
    if (idx === total - 1) return "$1 Million";
    var offset = prizeList.length - total;
    var target = idx + offset;
    if (target >= 0 && target < prizeList.length) {
      return prizeList.slice(target, target + 1).pop();
    }
    return "$" + ((idx + 1) * 1000).toLocaleString("en-US");
  }

  var firstItem = questions.slice(0, 1).pop();
  var firstP = firstItem.pNode;
  var best = localStorage.getItem(key) || "0";

  // 6. Top scoreboard with Выигрыш on the left
  var board = document.createElement("div");
  board.className = "quiz-scoreboard";
  board.innerHTML =
    '<span class="quiz-stats">' +
    'Выигрыш: <strong class="q-money">$0</strong> &nbsp;|&nbsp; ' +
    'Вопрос: <strong class="q-step">1</strong> / ' + total +
    ' &nbsp;|&nbsp; Верно: <strong class="q-curr">0</strong>' +
    ' &nbsp;|&nbsp; Рекорд: <strong class="q-best">' + best + '</strong></span>' +
    '<button type="button" class="quiz-reset-btn">Начать заново</button>';

  var studio = document.createElement("div");
  studio.className = "millionaire-studio";

  firstP.parentNode.insertBefore(board, firstP);
  firstP.parentNode.insertBefore(studio, firstP);

  questions.forEach(function (qItem) {
    qItem.pNode.remove();
    qItem.ulNode.remove();
    qItem.detNode.remove();
  });

  // 2 & 3. Random logo loader that fills question panel width
  function createRandomLogo() {
    var logoWrap = document.createElement("div");
    logoWrap.className = "quiz-logo-wrap";
    var logoImg = document.createElement("img");
    logoImg.className = "quiz-logo";
    logoImg.alt = "Who Wants to Be a Millionaire";
    logoWrap.appendChild(logoImg);

    var pool = logos.slice().sort(function () { return Math.random() - 0.5; });
    function nextImg() {
      if (pool.length === 0) {
        logoWrap.style.display = "none";
        return;
      }
      logoWrap.style.display = "flex";
      logoImg.src = pool.shift();
    }
    logoImg.onerror = nextImg;
    nextImg();

    return logoWrap;
  }

  function getRank(s, t) {
    var p = Math.round((s / t) * 100);
    if (p === 100) return { p: p, title: "Миллионер! (5+)", desc: "Безупречный результат — вы забрали $1 Million!" };
    if (p >= 80)  return { p: p, title: "Отлично (5)", desc: "Прекрасное знание темы!" };
    if (p >= 60)  return { p: p, title: "Хорошо (4)", desc: "Достойный результат, но есть пара нюансов." };
    if (p >= 40)  return { p: p, title: "Удовлетворительно (3)", desc: "База есть, стоит повторить материал." };
    return { p: p, title: "Нужна тренировка (2)", desc: "Изучите пояснения и попробуйте ещё раз." };
  }

  function showEnd() {
    var r = getRank(score, total);
    studio.innerHTML = "";
    studio.appendChild(createRandomLogo());

    var endBox = document.createElement("div");
    endBox.className = "quiz-final-result";
    endBox.innerHTML =
      '<div class="result-header">Игра окончена</div>' +
      '<div class="result-money">Итоговый выигрыш: ' + winnings + '</div>' +
      '<div class="result-score">Верных ответов: ' + score + ' из ' + total + ' (' + r.p + '%)</div>' +
      '<div class="result-rank">' + r.title + '</div>' +
      '<div class="result-msg">' + r.desc + '</div>' +
      '<button type="button" class="quiz-next-btn result-retry">Сыграть ещё раз</button>';

    studio.appendChild(endBox);
    endBox.querySelector(".result-retry").addEventListener("click", resetGame);
  }

  function renderStep(idx) {
    var item = questions.slice(idx, idx + 1).pop();
    if (!item) return;

    board.querySelector(".q-step").textContent = String(idx + 1);
    studio.innerHTML = "";

    // Show a random logo on EVERY question
    studio.appendChild(createRandomLogo());

    var card = document.createElement("div");
    card.className = "dg-quiz";

    var qDiv = document.createElement("div");
    qDiv.className = "quiz-question";
    qDiv.innerHTML = item.qHtml;
    card.appendChild(qDiv);

    var optsDiv = document.createElement("div");
    optsDiv.className = "quiz-options";

    var expDiv = document.createElement("div");
    expDiv.className = "quiz-explanation";
    expDiv.innerHTML = item.expHtml;
    expDiv.style.display = "none";

    var nextBtn = document.createElement("button");
    nextBtn.type = "button";
    nextBtn.className = "quiz-next-btn";
    nextBtn.textContent = (idx === total - 1) ? "Завершить и узнать результат" : "Следующий вопрос →";
    nextBtn.style.display = "none";

    nextBtn.addEventListener("click", function () {
      if (cur < total - 1) {
        cur++;
        renderStep(cur);
      } else {
        showEnd();
      }
    });

    var answered = false;

    item.options.forEach(function (opt) {
      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "quiz-option";
      btn.setAttribute("data-letter", opt.letter);
      btn.innerHTML = '<span class="quiz-letter">' + opt.letter + ':</span><span>' + opt.html + '</span>';

      btn.addEventListener("click", function () {
        if (answered) return;
        answered = true;

        var allBtns = optsDiv.querySelectorAll(".quiz-option");
        if (opt.letter === item.correct) {
          btn.classList.add("is-correct");
          score++;
          if (!busted) {
            winnings = getMoney(idx);
          }
        } else {
          btn.classList.add("is-wrong");
          // Any wrong answer drops prize money to $0
          busted = true;
          winnings = "$0";
          for (var m = 0; m < allBtns.length; m++) {
            if (allBtns.item(m).getAttribute("data-letter") === item.correct) {
              allBtns.item(m).classList.add("is-correct");
            }
          }
        }

        for (var n = 0; n < allBtns.length; n++) {
          allBtns.item(n).disabled = true;
        }
        expDiv.style.display = "block";
        nextBtn.style.display = "inline-flex";

        board.querySelector(".q-money").textContent = winnings;
        board.querySelector(".q-curr").textContent = String(score);

        var prev = Number(localStorage.getItem(key) || 0);
        if (score > prev) {
          localStorage.setItem(key, String(score));
          board.querySelector(".q-best").textContent = String(score);
        }
      });

      optsDiv.appendChild(btn);
    });

    card.appendChild(optsDiv);
    card.appendChild(expDiv);

    var footer = document.createElement("div");
    footer.className = "quiz-footer-actions";
    footer.appendChild(nextBtn);
    card.appendChild(footer);

    studio.appendChild(card);
  }

  function resetGame() {
    cur = 0;
    score = 0;
    winnings = "$0";
    busted = false;
    board.querySelector(".q-money").textContent = "$0";
    board.querySelector(".q-curr").textContent = "0";
    renderStep(0);
  }

  board.querySelector(".quiz-reset-btn").addEventListener("click", resetGame);

  renderStep(0);
});
</script>
