<script>
document.addEventListener('DOMContentLoaded', () => {
  const content = document.querySelector('.content, main, .markdown-rendered');
  if (content) content.classList.add('tts-enabled');
});

document.addEventListener('click', function (e) {
  if (e.target.closest('a, button, input, summary, .dg-quiz, .no-tts')) return;

  const directTag = e.target.closest('.tts-enabled [lang], .tts-enabled [data-tts]');
  const blockEl = e.target.closest('.tts-enabled .poem, .tts-enabled p, .tts-enabled li, .tts-enabled td, .tts-enabled th, .tts-enabled blockquote');
  const targetEl = directTag || blockEl;

  if (!targetEl || !('speechSynthesis' in window)) return;

  // Strip emojis AND any word/token containing IPA phonetic symbols (ə, æ, ɪ, ŋ, ˈ, ː, θ, ð, ʃ, ʒ, etc.)
  const clean = (str) => str
    .replace(/[\p{Extended_Pictographic}\u{FE0F}\u{200D}]/gu, '')
    .replace(/\S*[\u0250-\u02AF\u02B0-\u02FF\u00E6\u00F0\u014B\u03B8]\S*/g, '')
    .replace(/\s+/g, ' ')
    .trim();

  const queue = [];
  const selection = window.getSelection().toString().trim();

  if (selection.length > 0) {
    const cleanedSel = clean(selection);
    if (cleanedSel) queue.push({ text: cleanedSel, lang: null });
  } else {
    const walk = (node, inheritedLang) => {
      if (node.nodeType === Node.ELEMENT_NODE) {
        const customText = node.getAttribute('data-tts');
        const nodeLang = node.getAttribute('lang') || inheritedLang;
        if (customText) {
          const c = clean(customText);
          if (c) queue.push({ text: c, lang: nodeLang });
          return;
        }
        node.childNodes.forEach(child => walk(child, nodeLang));
      } else if (node.nodeType === Node.TEXT_NODE) {
        const txt = clean(node.textContent);
        if (txt && /[a-zA-Zа-яА-ЯёЁ\u0590-\u05FF0-9]/.test(txt)) {
          queue.push({ text: txt, lang: inheritedLang });
        }
      }
    };
    walk(targetEl, targetEl.getAttribute('lang'));
  }

  const finalQueue = [];
  queue.forEach(item => {
    if (item.lang) {
      finalQueue.push(item);
    } else {
      const parts = item.text.split(/([A-Za-z][A-Za-z0-9\s'".,!?;:\-–—()]*[A-Za-z0-9!?."')])/g)
        .map(s => s.trim())
        .filter(s => s && /[a-zA-Zа-яА-ЯёЁ0-9]/.test(s));
      parts.forEach(p => {
        const isEn = /[a-zA-Z]/.test(p) && !/[а-яА-ЯёЁ]/.test(p);
        finalQueue.push({ text: p, lang: isEn ? 'en-US' : 'ru-RU' });
      });
    }
  });

  // If the entire clicked line was IPA transcription, finalQueue is empty -> stay silent
  if (!finalQueue.length) return;

  document.querySelectorAll('.tts-speaking').forEach(n => n.classList.remove('tts-speaking'));
  targetEl.classList.add('tts-speaking');

  if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();

  const voices = window.speechSynthesis.getVoices();
  const getVoice = (lang) =>
    voices.filter(x => x.lang.toLowerCase().startsWith(lang.toLowerCase()) && x.localService).pop() ||
    voices.find(x => x.lang && x.lang.toLowerCase().startsWith(lang.slice(0, 2).toLowerCase()));

  finalQueue.forEach((seg, idx) => {
    const u = new SpeechSynthesisUtterance(seg.text);
    u.lang = seg.lang;
    u.rate = seg.lang.startsWith('ru') ? 0.98 : 0.78;
    u.pitch = 1;

    const voice = getVoice(seg.lang);
    if (voice) u.voice = voice;

    if (idx === finalQueue.length - 1) {
      u.onend = u.onerror = () => targetEl.classList.remove('tts-speaking');
    }
    window.speechSynthesis.speak(u);
  });
});
</script>
