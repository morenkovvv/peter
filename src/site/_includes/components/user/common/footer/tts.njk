<script>
document.addEventListener('DOMContentLoaded', () => {
  const content = document.querySelector('.content, main, .markdown-rendered');
  if (content) content.classList.add('tts-enabled');
});

document.addEventListener('click', function (e) {
  if (e.target.closest('a, button, input, summary, .dg-quiz, .no-tts')) return;

  const el = e.target.closest('.tts-enabled p, .tts-enabled li, .tts-enabled td, .tts-enabled th, .tts-enabled blockquote');
  if (!el || !('speechSynthesis' in window)) return;

  const selection = window.getSelection().toString().trim();
  const rawText = selection.length > 0 ? selection : el.innerText.trim();
  if (!rawText) return;

  // 1. Strip all emojis and variation selectors so they aren't spoken aloud
  const cleanText = rawText
    .replace(/[\p{Extended_Pictographic}\u{FE0F}\u{200D}]/gu, '')
    .replace(/\s+/g, ' ')
    .trim();

  if (!cleanText) return;

  // 2. Split text into alternating Russian and English segments in reading order
  const parts = cleanText.split(/([A-Za-z][A-Za-z0-9\s'".,!?;:\-–—()]*[A-Za-z0-9!?."')])/g)
    .map(s => s.trim())
    .filter(s => s && /[a-zA-Zа-яА-ЯёЁ0-9]/.test(s));

  if (!parts.length) return;

  document.querySelectorAll('.tts-speaking').forEach(node => node.classList.remove('tts-speaking'));
  el.classList.add('tts-speaking');

  if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();

  const voices = window.speechSynthesis.getVoices();
  const getVoice = (lang) =>
    voices.filter(x => x.lang === lang && x.localService).pop() ||
    voices.find(x => x.lang && x.lang.startsWith(lang.slice(0, 2)));

  // 3. Queue each chunk with its matching language voice
  parts.forEach((chunk, index) => {
    const isEnglish = /[a-zA-Z]/.test(chunk) && !/[а-яА-ЯёЁ]/.test(chunk);
    const lang = isEnglish ? 'en-US' : 'ru-RU';

    const u = new SpeechSynthesisUtterance(chunk);
    u.lang = lang;
    u.rate = isEnglish ? 0.78 : 0.98;
    u.pitch = 1;

    const voice = getVoice(lang);
    if (voice) u.voice = voice;

    if (index === parts.length - 1) {
      u.onend = u.onerror = () => el.classList.remove('tts-speaking');
    }

    window.speechSynthesis.speak(u);
  });
});
</script>
