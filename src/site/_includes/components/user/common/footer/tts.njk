<script>
document.addEventListener('DOMContentLoaded', () => {
  const content = document.querySelector('.content, main, .markdown-rendered');
  if (content) {
    content.classList.add('tts-enabled');
    content.querySelectorAll('p br, li br, blockquote br').forEach(br => {
      const gap = document.createElement('span');
      gap.className = 'br-gap';
      br.replaceWith(gap);
    });
  }
});

document.addEventListener('click', function (e) {
  if (e.target.closest('a, button, input, summary, .dg-quiz, .no-tts')) return;

  const directTag = e.target.closest('.tts-enabled [lang], .tts-enabled [data-tts]');
  const blockEl = e.target.closest('.tts-enabled .poem, .tts-enabled p, .tts-enabled li, .tts-enabled td, .tts-enabled th, .tts-enabled blockquote');
  const targetEl = directTag || blockEl;

  if (!targetEl || !('speechSynthesis' in window)) return;

const clean = (htmlStr) => htmlStr
  // 1. Convert <br> and closing block tags into newlines for TTS pauses
  .replace(/<br\s*\/?>|<\/p>|<\/div>/gi, '\n')
  // 2. Catch ANY closing tag followed by a dot and replace the dot with a space
  .replace(/(<\/[^>]+>)\./g, '$1 ')
  // 3. Strip all remaining HTML tags
  .replace(/<[^>]*>/g, '')
  // 4. Remove emojis, regional flags, tag sequences, and variation selectors
  .replace(/[\p{Extended_Pictographic}\u{1F1E6}-\u{1F1FF}\u{20E3}\u{E0020}-\u{E007F}\u{FE0F}\u{200D}]/gu, '')
  // 5. Remove words containing IPA phonetic characters
  .replace(/\S*[\u0250-\u02AF\u02B0-\u02FF\u00E6\u00F0\u014B\u03B8]\S*/g, '')

  // Quotes and guillemets (keeps apostrophes inside words like don't or it's)
  .replace(/[“”«»]/g, '')
  .replace(/(?<![a-zA-Z0-9])['’]|['’](?![a-zA-Z0-9])/g, '')

  // Brackets and parentheses (commas add a natural pause on iOS)
  .replace(/\(/g, ', ')
  .replace(/\)/g, ', ')
  .replace(/[\[\]\{\}]/g, '')

  // Ellipses (both three dots and the single Unicode character)
  .replace(/\.\.\.|…/g, '.')

  // Slashes and connectors (replaced with spaces to keep words separate)
  .replace(/[\\/_=~]/g, ' ')

  // Formatting and code symbols
  .replace(/[#*`]/g, '')

  // Orphaned-dot cleanup (e.g., "word [IPA]." -> "word . " -> "word.")
  .replace(/[ \t]+\./g, '.')

  // Final whitespace cleanup (preserves \n pauses!)
  .replace(/[ \t]+/g, ' ')       // Collapse multiple spaces/tabs into one space
  .replace(/ *\n */g, '\n')      // Remove spaces right before or after a newline
  .replace(/\n{2,}/g, '\n')      // Collapse multiple blank lines into a single pause
  .trim();


  const queue = [];
  const selection = window.getSelection().toString().trim();

  if (selection.length > 0) {
    const cleanedSel = clean(selection);
    if (cleanedSel) queue.push({ text: cleanedSel, lang: null });
  } else {
    const walk = (node, inheritedLang) => {
      if (node.nodeType === Node.ELEMENT_NODE) {
        const customText = node.getAttribute('data-tts');
        const nodeLang = node.getAttribute('lang') || inheritedLang;
        if (customText) {
          const c = clean(customText);
          if (c) queue.push({ text: c, lang: nodeLang });
          return;
        }
        node.childNodes.forEach(child => walk(child, nodeLang));
      } else if (node.nodeType === Node.TEXT_NODE) {
        const txt = clean(node.textContent);
        if (txt && /[a-zA-Zа-яА-ЯёЁ\u0590-\u05FF0-9]/.test(txt)) {
          queue.push({ text: txt, lang: inheritedLang });
        }
      }
    };
    walk(targetEl, targetEl.getAttribute('lang'));
  }

  // Strictly separate Latin (English) runs from Cyrillic (Russian) runs
  const finalQueue = [];
  queue.forEach(item => {
    if (item.lang) {
      finalQueue.push(item);
    } else {
      const parts = item.text.split(/([A-Za-z][A-Za-z0-9\s'".,!?;:\-–—()]*)/g)
        .map(s => s.trim())
        .filter(s => s && /[a-zA-Zа-яА-ЯёЁ0-9]/.test(s));
      parts.forEach(p => {
        const hasCyrillic = /[а-яА-ЯёЁ]/.test(p);
        const hasLatin = /[a-zA-Z]/.test(p);
        const lang = (hasLatin && !hasCyrillic) ? 'en-US' : 'ru-RU';
        finalQueue.push({ text: p, lang });
      });
    }
  });

  if (!finalQueue.length) return;

  document.querySelectorAll('.tts-speaking').forEach(n => n.classList.remove('tts-speaking'));
  targetEl.classList.add('tts-speaking');

  if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();

  const voices = window.speechSynthesis.getVoices();
  const getVoice = (lang) => {
    const prefix = lang.slice(0, 2).toLowerCase();
    return voices.find(x => x.lang && x.lang.toLowerCase().startsWith(prefix) && x.localService) ||
           voices.find(x => x.lang && x.lang.toLowerCase().startsWith(prefix));
  };

  finalQueue.forEach((seg, idx) => {
    const u = new SpeechSynthesisUtterance(seg.text);
    u.lang = seg.lang;
    // Russian = 1.0 (natural pace), English/other = 0.7 (slow & clear)
    u.rate = seg.lang.startsWith('ru') ? 1.0 : 0.7;
    u.pitch = 1;

    const voice = getVoice(seg.lang);
    if (voice) u.voice = voice;

    if (idx === finalQueue.length - 1) {
      u.onend = u.onerror = () => targetEl.classList.remove('tts-speaking');
    }
    window.speechSynthesis.speak(u);
  });
});
</script>
